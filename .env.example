# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.
#   cp .env.example .env

# OpenRouter key — drives the scorer and judge (and P if you point it at an
# OpenRouter model id). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI key — only needed if the prompted model P uses an `oai/<model>` id
# (direct OpenAI API), e.g. the default P `oai/gpt-6-astra`.
OPENAI_API_KEY=
